# The browser calls the web server, which forwards these requests to FastAPI.
VITE_API_URL=/api/v1
# Upstream for local Vite development and preview. Compose supplies its own.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional campaign and checkout analytics. Disable enhanced measurement in
# the GA4 web stream so it records only the events sent by the application.
# For production Compose, set this variable in the root .env before building.
# Use a GA4 web stream with Enhanced Measurement turned off. This keeps Google
# from automatically collecting routes, form interactions, and download links.
VITE_GA4_MEASUREMENT_ID=
