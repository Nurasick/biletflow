{
  // The venv lives in backend/, not at the workspace root, so VS Code's
  // auto-discovery misses it. Without this, Pylance resolves none of the
  // dependencies and offers no completions.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",

  // `app` is a package under backend/, not at the workspace root. This is what
  // makes `from app.db.base_class import Base` resolve in the editor. It
  // mirrors `pythonpath = ["."]` in backend/pyproject.toml, which is what
  // pytest uses at runtime.
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.analysis.typeCheckingMode": "basic",

  // Run tests from backend/, matching CI's working-directory.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],

  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true
  }
}
