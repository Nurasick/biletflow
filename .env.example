# Postgres container bootstrap — these create the DB on first boot.
POSTGRES_USER=biletflow
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=biletflow
VERSION = 0.1.0
# Host is 'db' (the compose service name), not localhost.
# '+psycopg' selects psycopg 3 — without it SQLAlchemy looks for psycopg2.
DATABASE_URL=postgresql+psycopg://biletflow:devpassword@db:5432/biletflow

SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# If CORS_ORIGINS is typed list[str], this must be JSON: ["http://localhost:5173"]
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=local
