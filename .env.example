# Postgres container bootstrap — these create the DB on first boot.
POSTGRES_USER=biletflow
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=biletflow
VERSION=0.1.0

# Host-facing PostgreSQL URL (used outside Docker by alembic, pytest, scripts).
# Port 5433 is what docker-compose.yml publishes (5433 -> 5432) to avoid colliding
# with any local Postgres installation. Inside Docker, Compose overrides this to db:5432.
# '+psycopg' selects psycopg 3.
DATABASE_URL=postgresql+psycopg://biletflow:devpassword@localhost:5433/biletflow

# Optional PostgreSQL TLS mode for staging/production (e.g. require, verify-ca, verify-full).
DB_SSLMODE=

# REQUIRED: generate a unique random secret before starting the API:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional application-level Fernet key for encrypting sensitive stored fields
# (e.g. payout account references). Requires `cryptography` or a KMS provider.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed origins for browser clients that call the API directly (web :5173 + Expo web :8081).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Public origins for links sent in email, campaign QR codes, calendar URLs, and uploaded images.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# Supported ticket currencies (comma-separated ISO 4217 codes; defaults to KZT).
DEFAULT_CURRENCY=KZT
SUPPORTED_CURRENCIES=KZT

# Payment gateway (§4.6).
# PAYMENT_PROVIDER: simulator | halyk_sandbox | halyk
# In halyk_sandbox mode, empty credentials automatically use Halyk Bank's official
# public developer sandbox terminal (https://test-epay.epayment.kz).
PAYMENT_PROVIDER=halyk_sandbox
HALYK_EPAY_CLIENT_ID=
HALYK_EPAY_CLIENT_SECRET=
HALYK_EPAY_TERMINAL=
HALYK_EPAY_OAUTH_URL=
HALYK_EPAY_API_URL=
HALYK_EPAY_PAYFORM_SCRIPT_URL=

# Transactional email delivery (§4.10, §9).
# EMAIL_PROVIDER: auto | console | smtp | resend
# In local Compose, SMTP_HOST defaults to mailpit (web inbox at http://localhost:8025).
EMAIL_PROVIDER=auto
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=BiletFlow <no-reply@biletflow.local>
# Optional Resend HTTP API adapter (used automatically when RESEND_API_KEY is set).
RESEND_API_KEY=

# Object storage for event photos and support attachments.
# Leave AWS_S3_BUCKET empty to store files on local disk under MEDIA_ROOT.
AWS_S3_BUCKET=
AWS_REGION=
# For S3-compatible providers (MinIO, Cloudflare R2, DigitalOcean Spaces), set both:
# AWS_S3_ENDPOINT_URL=https://s3.example.com
# AWS_S3_ADDRESSING_STYLE=path
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=virtual
# Boto3 uses the API's IAM role or its standard credential providers.
# For local Compose with environment credentials, set these in your private .env:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Production deployment settings (used by docker-compose.prod.yml).
ENVIRONMENT=local
TLS_DOMAIN=localhost
API_WORKERS=2
