# Postgres container bootstrap — these create the DB on first boot.
POSTGRES_USER=biletflow
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=biletflow
VERSION = 0.1.0
# This is the HOST-facing URL, used by anything you run outside Docker:
# alembic, pytest, ad-hoc scripts. Port 5433 is what compose publishes
# (it maps 5433->5432 so it can't collide with a local Postgres).
# The api container does NOT use this value — docker-compose.yml overrides
# DATABASE_URL with the in-network address (db:5432) via its `environment:` key.
# '+psycopg' selects psycopg 3 — without it SQLAlchemy looks for psycopg2.
DATABASE_URL=postgresql+psycopg://biletflow:devpassword@localhost:5433/biletflow

SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# If CORS_ORIGINS is typed list[str], this must be JSON: ["http://localhost:5173"]
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=local
