# Postgres container bootstrap — these create the DB on first boot.
POSTGRES_USER=biletflow
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=biletflow
VERSION = 0.1.0
# This is the HOST-facing URL, used by anything you run outside Docker:
# alembic, pytest, ad-hoc scripts. Port 5433 is what compose publishes
# (it maps 5433->5432 so it can't collide with a local Postgres).
# The api container does NOT use this value — docker-compose.yml overrides
# DATABASE_URL with the in-network address (db:5432) via its `environment:` key.
# '+psycopg' selects psycopg 3 — without it SQLAlchemy looks for psycopg2.
DATABASE_URL=postgresql+psycopg://biletflow:devpassword@localhost:5433/biletflow

SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed origins for browser clients that call the API directly.
CORS_ORIGINS=http://localhost:5173

# Public origins for links sent in email, campaign QR codes, and uploaded images.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# Configure both for new event photos to use a private S3 bucket.
AWS_S3_BUCKET=
AWS_REGION=
# Boto3 uses the API's IAM role or its standard credential providers.
# For local Compose with environment credentials, set these in your private .env:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

ENVIRONMENT=local
