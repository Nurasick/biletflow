  "info": {
    "title": "BiletFlow",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Exchange credentials for an access/refresh pair.\n\nThe password is checked before the status is, so a suspended account is only\ndistinguishable to someone who already knows its password (01-identity.md:\nsuspension must not be distinguishable to strangers).",
        "operationId": "login_api_v1_auth_login_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-auth-mode",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Auth-Mode"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Clear the refresh cookie; the caller discards its in-memory access token.\n\nFor a browser this genuinely ends the session, because the refresh token\nonly ever existed as the cookie being deleted here. For a client in bearer\nmode nothing is revoked: that refresh token stays valid until it expires,\nand this codebase has no store of issued tokens to mark as spent. Real\nrevocation would be added here, without changing any client.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Trade a refresh token for a fresh pair.\n\nThe token comes from the body for clients in bearer mode and from the\nhttpOnly cookie for browsers. A cookie-borne token additionally has to pass\nthe CSRF check, because unlike a body it is sent without the caller asking.\n\nThe status is re-read here rather than trusted from the token, so suspending\nan account takes effect at the next refresh instead of at the token's expiry.",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-auth-mode",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Auth-Mode"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RefreshRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Data"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Create an account. The new user is active but not email-verified.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
