{
  "expo": {
    "name": "BiletFlow",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/biletflow-icon.png",
    "scheme": "mobile",
    "ios": {
      "bundleIdentifier": "kz.biletflow.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "BiletFlow uses the camera to scan admission and campaign QR codes."
      }
    },
    "android": {
      "package": "kz.biletflow.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#593BC9",
        "foregroundImage": "./assets/images/biletflow-mark.png",
        "monochromeImage": "./assets/images/biletflow-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static",
      "favicon": "./assets/images/biletflow-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#21183C",
          "image": "./assets/images/biletflow-mark.png",
          "imageWidth": 144
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "BiletFlow lets organizers choose event photos from their library."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BiletFlow to scan admission ticket QR codes at your assigned events.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
